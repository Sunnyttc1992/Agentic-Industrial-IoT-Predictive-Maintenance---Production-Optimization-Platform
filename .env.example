ENVIRONMENT=development
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
AWS_REGION=us-east-1
KINESIS_STREAM_NAME=industrial-iot-telemetry
AWS_IOT_ENDPOINT=

AWS_IOT_ENDPOINT=your-endpoint.amazonaws.com

AWS_IOT_CERT=certificates/device.pem.crt

AWS_IOT_PRIVATE_KEY=certificates/private.pem.key

AWS_IOT_ROOT_CA=certificates/AmazonRootCA1.pem

AWS_IOT_CLIENT_ID=factory-gateway-01

# Enable the FastAPI dashboard's separate AWS IoT Core subscription.
REALTIME_MQTT_ENABLED=true
REALTIME_MQTT_TOPIC=sunny/factory1/machines/+/telemetry
# Do not reuse AWS_IOT_CLIENT_ID: a duplicate client ID disconnects the simulator.
AWS_IOT_DASHBOARD_CLIENT_ID=factory-operations-console
